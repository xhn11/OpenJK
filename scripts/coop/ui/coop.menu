// COOP MENU (design 28): host a new or saved game, or join a host. Opened from the main menu.
{
	menuDef
	{
		name					"coopMenu"
		fullScreen				1
		rect					0 0 640 480
		visible					1
		focusColor				1 1 1 1
		descX					320
		descY					425
		descScale				.8
		descColor				.235 .882 .847 1
		descAlignment			ITEM_ALIGN_CENTER

		onESC
		{
			play				"sound/interface/menuroam.wav" ;
			close				coopMenu ;
			open				mainMenu
		}

		itemDef
		{
			name				frame_pic
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			background			"gfx/menus/menu1"
			forecolor			1 1 1 1
			visible				1
			decoration
		}

		itemDef
		{
			name				title
			text				"COOP - 2 HRACI"
			style				WINDOW_STYLE_EMPTY
			rect				120 60 400 30
			font				3
			textscale			1
			textalign			ITEM_ALIGN_CENTER
			textalignx			200
			textstyle			3
			forecolor			1 1 1 1
			visible				1
			decoration
		}

		// ---------------------------------------------------------------- player
		itemDef
		{
			name				coopname
			type				ITEM_TYPE_EDITFIELD
			style				WINDOW_STYLE_EMPTY
			text				"Jmeno: "
			descText			"Tve jmeno nad hlavou na obrazovce partnera"
			cvar				coop_name
			maxChars			30
			rect				140 110 360 20
			font				2
			textscale			.9
			textalign			ITEM_ALIGN_LEFT
			textalignx			0
			textaligny			0
			forecolor			1 1 1 1
			visible				1
		}

		itemDef
		{
			name				cooppassword
			type				ITEM_TYPE_EDITFIELD
			style				WINDOW_STYLE_EMPTY
			text				"Heslo: "
			descText			"Nepovinne: hostitel i pripojujici se hrac zadaji stejne"
			cvar				coop_password
			maxChars			30
			rect				140 135 360 20
			font				2
			textscale			.9
			textalign			ITEM_ALIGN_LEFT
			textalignx			0
			textaligny			0
			forecolor			1 1 1 1
			visible				1
		}

		// ---------------------------------------------------------------- host
		itemDef
		{
			name				hosttitle
			text				"HOSTOVAT"
			style				WINDOW_STYLE_EMPTY
			rect				140 175 360 20
			font				3
			textscale			.9
			textalign			ITEM_ALIGN_LEFT
			forecolor			.65 .65 1 1
			visible				1
			decoration
		}

		itemDef
		{
			name				hosteasy
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			text				"Nova hra - Padawan"
			descText			"Zacne kampan (kejim_post) a ceka na partnera, UDP port 29170"
			rect				160 200 300 20
			font				2
			textscale			.9
			textalign			ITEM_ALIGN_LEFT
			forecolor			1 1 1 1
			visible				1
			action
			{
				play			"sound/interface/button1.wav" ;
				exec			"g_spskill 0; coop_host; map kejim_post" ;
				close			all
			}
		}

		itemDef
		{
			name				hostmedium
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			text				"Nova hra - Jedi"
			descText			"Zacne kampan (kejim_post) a ceka na partnera, UDP port 29170"
			rect				160 222 300 20
			font				2
			textscale			.9
			textalign			ITEM_ALIGN_LEFT
			forecolor			1 1 1 1
			visible				1
			action
			{
				play			"sound/interface/button1.wav" ;
				exec			"g_spskill 1; coop_host; map kejim_post" ;
				close			all
			}
		}

		itemDef
		{
			name				hosthard
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			text				"Nova hra - Rytir Jedi"
			descText			"Zacne kampan (kejim_post) a ceka na partnera, UDP port 29170"
			rect				160 244 300 20
			font				2
			textscale			.9
			textalign			ITEM_ALIGN_LEFT
			forecolor			1 1 1 1
			visible				1
			action
			{
				play			"sound/interface/button1.wav" ;
				exec			"g_spskill 2; coop_host; map kejim_post" ;
				close			all
			}
		}

		itemDef
		{
			name				hostload
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			text				"Nacist ulozenou hru"
			descText			"Hostuje a vybere save, partner dostane svou ulozenou vybavu"
			rect				160 266 300 20
			font				2
			textscale			.9
			textalign			ITEM_ALIGN_LEFT
			forecolor			1 1 1 1
			visible				1
			action
			{
				play			"sound/interface/button1.wav" ;
				exec			"coop_host" ;
				close			coopMenu ;
				open			loadgameMenu
			}
		}

		// ---------------------------------------------------------------- join
		itemDef
		{
			name				jointitle
			text				"PRIPOJIT"
			style				WINDOW_STYLE_EMPTY
			rect				140 300 360 20
			font				3
			textscale			.9
			textalign			ITEM_ALIGN_LEFT
			forecolor			.65 .65 1 1
			visible				1
			decoration
		}

		itemDef
		{
			name				joinaddr
			type				ITEM_TYPE_EDITFIELD
			style				WINDOW_STYLE_EMPTY
			text				"IP hostitele: "
			descText			"Adresa hostitele, napr. 192.168.1.20 nebo 100.64.0.2:29170"
			cvar				coop_connectaddr
			maxChars			60
			rect				160 325 340 20
			font				2
			textscale			.9
			textalign			ITEM_ALIGN_LEFT
			textalignx			0
			textaligny			0
			forecolor			1 1 1 1
			visible				1
		}

		itemDef
		{
			name				findbutton
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			text				"Najit hry v LAN"
			descText			"Vyplni IP prvniho nalezeneho hostitele v mistni siti"
			rect				160 372 300 20
			font				2
			textscale			.9
			textalign			ITEM_ALIGN_LEFT
			forecolor			1 1 1 1
			visible				1
			action
			{
				play			"sound/interface/button1.wav" ;
				exec			"coop_find"
			}
		}

		itemDef
		{
			name				joinbutton
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			text				"Pripojit"
			descText			"Pripoji se ke hre hostitele a objevi se vedle Kyla"
			rect				160 350 300 20
			font				2
			textscale			.9
			textalign			ITEM_ALIGN_LEFT
			forecolor			1 1 1 1
			visible				1
			action
			{
				play			"sound/interface/button1.wav" ;
				exec			"coop_connect" ;
				close			all
			}
		}

		// ---------------------------------------------------------------- back
		itemDef
		{
			name				backbutton
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			text				"Zpet"
			rect				115 444 130 24
			font				3
			textscale			1
			textalign			ITEM_ALIGN_CENTER
			textalignx			65
			textstyle			3
			forecolor			0.65 0.65 1 1
			visible				1
			action
			{
				play			"sound/interface/menuroam.wav" ;
				close			coopMenu ;
				open			mainMenu
			}
		}
	}
}
